 // ── helpers ───────────────────────────────────────────────────────────────────
 
+pub(crate) fn parse_video_target(
+    args: &Value,
+    record_video: bool,
+) -> Result<VideoTarget, ToolResult> {
+    let Some(raw) = args.get("video_target") else {
+        return Ok(VideoTarget::Display);
+    };
+    if !record_video {
+        return Err(ToolResult::error(
+            "`video_target` requires `record_video: true`.",
+        ));
+    }
+    let object = raw.as_object().ok_or_else(|| {
+        ToolResult::error("`video_target` must be an object with pid and window_id.")
+    })?;
+    if object.keys().any(|key| key != "pid" && key != "window_id") {
+        return Err(ToolResult::error(
+            "`video_target` accepts only pid and window_id.",
+        ));
+    }
+    let pid = raw
+        .get("pid")
+        .and_then(Value::as_i64)
+        .and_then(|value| i32::try_from(value).ok())
+        .filter(|value| *value > 0)
+        .ok_or_else(|| {
+            ToolResult::error("`video_target.pid` must be an integer between 1 and 2147483647.")
+        })?;
+    let window_id = raw
+        .get("window_id")
+        .and_then(Value::as_u64)
+        .and_then(|value| u32::try_from(value).ok())
+        .filter(|value| *value > 0)
+        .ok_or_else(|| {
+            ToolResult::error(
+                "`video_target.window_id` must be an integer between 1 and 4294967295.",
+            )
+        })?;
+    Ok(VideoTarget::Window { pid, window_id })
+}
