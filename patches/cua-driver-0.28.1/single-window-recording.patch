+use std::{
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc, Mutex, Once,
+    },
+};
+
+use cua_driver_core::{
+    recording::RecordingSession,
+    recording_tools::{GetRecordingStateTool, StartRecordingTool, StopRecordingTool},
+    tool::Tool,
+    video::{
+        set_video_backend_factory, VideoBackend, VideoBackendFactory, VideoMetadata, VideoTarget,
+    },
+};
+use serde_json::{json, Value};
+
+static STARTED: Mutex<Vec<(PathBuf, VideoTarget)>> = Mutex::new(Vec::new());
+static STOPPED: Mutex<Vec<PathBuf>> = Mutex::new(Vec::new());
+
+struct StubVideo(PathBuf);
+
+impl VideoBackend for StubVideo {
+    fn stop(self: Box<Self>) -> anyhow::Result<VideoMetadata> {
+        STOPPED.lock().unwrap().push(self.0.clone());
+        std::fs::write(&self.0, b"test fixture, not a recording")?;
+        Ok(VideoMetadata {
+            path: self.0,
+            duration_ms: 1,
+            finalized: true,
+        })
+    }
+}
+
+struct TargetFactory;
+
+impl VideoBackendFactory for TargetFactory {
+    fn start(&self, output_path: &Path) -> anyhow::Result<Box<dyn VideoBackend>> {
+        self.start_target(output_path, &VideoTarget::Display)
+    }
+
+    fn start_target(
+        &self,
+        output_path: &Path,
+        target: &VideoTarget,
+    ) -> anyhow::Result<Box<dyn VideoBackend>> {
+        STARTED
+            .lock()
+            .unwrap()
+            .push((output_path.to_owned(), *target));
+        if matches!(target, VideoTarget::Window { pid: 777, .. }) {
+            anyhow::bail!("requested window is unavailable");
+        }
+        Ok(Box::new(StubVideo(output_path.to_owned())))
+    }
+}
+
+fn setup() -> tempfile::TempDir {
+    static REGISTER: Once = Once::new();
+    REGISTER.call_once(|| set_video_backend_factory(Box::new(TargetFactory)));
+    let directory = tempfile::tempdir().unwrap();
+    // Make cursor-sampler startup fail before spawning its polling thread.
+    // These tests exercise only the recording interface and fake video backend.
+    std::fs::create_dir(directory.path().join("cursor.jsonl")).unwrap();
+    directory
+}
+
+fn starts_for(path: &Path) -> Vec<VideoTarget> {
+    STARTED
+        .lock()
+        .unwrap()
+        .iter()
+        .filter(|(output, _)| output == path)
+        .map(|(_, target)| *target)
+        .collect()
+}
+
+fn stops_for(path: &Path) -> usize {
+    STOPPED
+        .lock()
+        .unwrap()
+        .iter()
+        .filter(|output| output.as_path() == path)
+        .count()
+}
+
+fn manifest(path: &Path) -> Value {
+    serde_json::from_slice(&std::fs::read(path.join("session.json")).unwrap()).unwrap()
+}
+
+#[test]
+fn advertised_schema_requires_video_and_bounded_window_identifiers() {
+    let tool = StartRecordingTool::new(Arc::new(RecordingSession::new()));
+    let validator = jsonschema::validator_for(&tool.def().input_schema).unwrap();
+    assert!(validator.is_valid(&json!({"output_dir": "/unused"})));
+    assert!(validator.is_valid(&json!({
+        "output_dir": "/unused",
+        "record_video": true,
+        "video_target": {"pid": i32::MAX, "window_id": u32::MAX}
+    })));
+    for arguments in [
+        json!({"output_dir": "/unused", "video_target": {"pid": 1, "window_id": 1}}),
+        json!({
+            "output_dir": "/unused",
+            "record_video": false,
+            "video_target": {"pid": 1, "window_id": 1}
+        }),
+        json!({
+            "output_dir": "/unused",
+            "record_video": true,
+            "video_target": {"pid": 0, "window_id": 1}
+        }),
+        json!({
+            "output_dir": "/unused",
+            "record_video": true,
+            "video_target": {"pid": 1, "window_id": 4294967296_u64}
+        }),
+    ] {
+        assert!(!validator.is_valid(&arguments), "accepted {arguments}");
+    }
+}
+
+#[test]
+fn display_only_backend_keeps_legacy_start_and_rejects_window_without_fallback() {
+    struct DisplayFactory(AtomicUsize);
+    impl VideoBackendFactory for DisplayFactory {
+        fn start(&self, output_path: &Path) -> anyhow::Result<Box<dyn VideoBackend>> {
+            self.0.fetch_add(1, Ordering::SeqCst);
+            Ok(Box::new(StubVideo(output_path.to_owned())))
+        }
+    }
+
+    let factory = DisplayFactory(AtomicUsize::new(0));
+    let path = Path::new("unused-video-target-fixture.mp4");
+    let _display = factory.start_target(path, &VideoTarget::Display).unwrap();
+    assert_eq!(factory.0.load(Ordering::SeqCst), 1);
+
+    let error = factory
+        .start_target(
+            path,
+            &VideoTarget::Window {
+                pid: 42,
+                window_id: 84,
+            },
+        )
+        .err()
+        .expect("a display-only backend must reject window capture");
+    assert!(error.to_string().contains("not supported"));
+    assert_eq!(
+        factory.0.load(Ordering::SeqCst),
+        1,
+        "a window request must never invoke display capture"
+    );
+}
+
+#[test]
+fn legacy_session_api_uses_display_and_no_video_clears_target() {
+    let directory = setup();
+    let path = directory.path().join("recording.mp4");
+    let session = RecordingSession::new();
+    session
+        .start(directory.path().to_str().unwrap(), true, None)
+        .unwrap();
+    assert_eq!(
+        session.current_state().video_target,
+        Some(VideoTarget::Display)
+    );
