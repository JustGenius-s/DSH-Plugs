+        json!({"pid": 42, "window_id": 84.5}),
+        json!({"pid": 42, "window_id": "84"}),
+        json!({"pid": 42, "window_id": null}),
+        json!({"pid": 42, "window_id": false}),
+        json!({"pid": 42, "window_id": 84, "display": true}),
