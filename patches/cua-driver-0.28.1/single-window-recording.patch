+use super::{select_owned_window, window_pixel_dimensions};
+
+#[derive(Debug, PartialEq, Eq)]
+struct Window {
+    id: u32,
+    pid: Option<i32>,
+}
+
+fn select(windows: Vec<Window>, pid: i32, id: u32) -> anyhow::Result<Window> {
+    select_owned_window(windows, pid, id, |window| window.id, |window| window.pid)
+}
+
+#[test]
+fn selects_exact_window_even_when_owner_has_other_windows() {
+    let selected = select(
+        vec![
+            Window {
+                id: 41,
+                pid: Some(10),
+            },
+            Window {
+                id: 42,
+                pid: Some(10),
+            },
+        ],
+        10,
+        42,
+    )
+    .unwrap();
+    assert_eq!(selected.id, 42);
+}
+
+#[test]
+fn missing_window_does_not_select_another_window_from_the_owner() {
+    let error = select(
+        vec![Window {
+            id: 41,
+            pid: Some(10),
+        }],
+        10,
+        42,
+    )
+    .unwrap_err();
+    assert!(error.to_string().contains("window id 42 not found"));
+}
+
+#[test]
+fn reused_window_id_with_different_owner_is_rejected() {
+    let error = select(
+        vec![
+            Window {
+                id: 42,
+                pid: Some(20),
+            },
+            Window {
+                id: 43,
+                pid: Some(10),
+            },
+        ],
+        10,
+        42,
+    )
+    .unwrap_err();
+    let message = error.to_string();
+    assert!(message.contains("belongs to pid 20"));
+    assert!(message.contains("not requested pid 10"));
+}
+
+#[test]
+fn window_without_known_owner_is_rejected() {
+    let error = select(vec![Window { id: 42, pid: None }], 10, 42).unwrap_err();
+    assert!(error.to_string().contains("has no owning application"));
+}
+
+#[test]
+fn window_dimensions_use_content_points_and_retina_scale() {
+    assert_eq!(
+        window_pixel_dimensions((801.0, 601.0), (900.0, 700.0), 2.0).unwrap(),
+        (1602, 1202)
+    );
+}
+
+#[test]
+fn odd_and_fractional_window_dimensions_round_up_to_even_pixels() {
+    assert_eq!(
+        window_pixel_dimensions((801.0, 600.25), (900.0, 700.0), 1.0).unwrap(),
+        (802, 602)
+    );
+    assert_eq!(
+        window_pixel_dimensions((640.5, 480.5), (900.0, 700.0), 1.5).unwrap(),
+        (962, 722)
+    );
+}
+
+#[test]
+fn unavailable_content_rect_falls_back_to_window_frame_points() {
+    for content in [(0.0, 0.0), (800.0, f64::NAN), (-1.0, 600.0)] {
+        assert_eq!(
+            window_pixel_dimensions(content, (800.0, 600.0), 2.0).unwrap(),
+            (1600, 1200)
+        );
+    }
+}
+
+#[test]
+fn rejects_invalid_scale_geometry_and_oversized_output() {
+    for scale in [0.0, -1.0, f64::NAN, f64::INFINITY] {
+        assert!(window_pixel_dimensions((800.0, 600.0), (800.0, 600.0), scale).is_err());
+    }
+    for frame in [(0.0, 600.0), (800.0, -1.0), (f64::INFINITY, 600.0)] {
+        assert!(window_pixel_dimensions((0.0, 0.0), frame, 1.0).is_err());
+    }
+    assert!(window_pixel_dimensions((8192.5, 600.0), (800.0, 600.0), 2.0).is_err());
+    assert!(window_pixel_dimensions((f64::MAX, 600.0), (800.0, 600.0), 2.0).is_err());
+    assert_eq!(
+        window_pixel_dimensions((8192.0, 600.0), (800.0, 600.0), 2.0).unwrap(),
+        (16384, 1200)
+    );
+}
