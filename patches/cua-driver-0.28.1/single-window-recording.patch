+#[tokio::test]
+async fn window_target_reaches_backend_and_survives_stop_in_state_and_manifest() {
+    let directory = setup();
+    let path = directory.path().join("recording.mp4");
+    let session = Arc::new(RecordingSession::new());
+    let target = VideoTarget::Window {
+        pid: i32::MAX,
+        window_id: u32::MAX,
+    };
+    let expected_json = json!({"type": "window", "pid": i32::MAX, "window_id": u32::MAX});
+
+    let started = StartRecordingTool::new(session.clone())
+        .invoke(json!({
+            "output_dir": directory.path(),
+            "record_video": true,
+            "video_target": {"pid": i32::MAX, "window_id": u32::MAX}
+        }))
+        .await;
+    assert_ne!(started.is_error, Some(true), "{started:?}");
+    let state = started.structured_content.unwrap();
+    assert_eq!(state["video_active"], true);
+    assert_eq!(state["video_target"], expected_json);
+    assert_eq!(starts_for(&path), vec![target]);
+    assert_eq!(session.current_state().video_target, Some(target));
+    assert_eq!(manifest(directory.path())["video_target"], expected_json);
+
+    let stopped = StopRecordingTool::new(session.clone())
+        .invoke(json!({}))
+        .await;
+    assert_ne!(stopped.is_error, Some(true), "{stopped:?}");
+    let state = GetRecordingStateTool::new(session).invoke(json!({})).await;
+    let state = state.structured_content.unwrap();
+    assert_eq!(state["enabled"], false);
+    assert_eq!(state["video_active"], false);
+    assert_eq!(state["video_target"], expected_json);
+    assert_eq!(state["last_video_path"], json!(path));
+    assert_eq!(manifest(directory.path())["video_target"], expected_json);
+    assert_eq!(stops_for(&path), 1);
