+use cua_driver_core::observation_projection::window_action_context;
+use serde_json::json;
+
+#[test]
+fn text_clients_receive_the_real_snapshot_binding_and_frame() {
+    let state = json!({
+        "pid": 42, "window_id": 73, "snapshot_id": "snapshot:real",
+        "screenshot_width": 1568, "screenshot_height": 1176,
+        "window_bounds": {"x": 100, "y": 80, "width": 1024, "height": 768},
+        "elements": [{"element_index": 7, "label": "Start"}],
+        "screenshot_png_b64": "large-private-image"
+    });
+    let text = window_action_context(&state).unwrap();
+    assert!(text.contains("\"snapshot_id\":\"snapshot:real\""));
+    assert!(text.contains("\"screenshot_width\":1568"));
+    assert!(text.contains("\"width\":1024"));
+    assert!(text.contains("bare element_index is not accepted"));
+    assert!(!text.contains("large-private-image"));
+    assert!(!text.contains("\"elements\""));
+}
+
+#[test]
+fn observation_only_images_do_not_claim_an_action_binding() {
+    let text = window_action_context(&json!({
+        "pid": 42, "window_id": 73, "screenshot_width": 500, "screenshot_height": 375
+    })).unwrap();
+    assert!(!text.contains("snapshot_id"));
+    assert!(!text.contains("For AX actions"));
+}
+
+#[test]
+fn unresolved_windows_keep_their_degradation_without_inventing_a_token() {
+    let text = window_action_context(&json!({
+        "pid": 42, "window_id": 73, "degraded_reason": "ax_window_unresolved"
+    })).unwrap();
+    assert!(text.contains("ax_window_unresolved"));
+    assert!(!text.contains("snapshot_id"));
+    assert!(window_action_context(&json!({"pid":42,"window_id":73})).is_none());
+}
