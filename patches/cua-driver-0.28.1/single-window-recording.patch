+#![cfg(feature = "yaml")]
+
+use std::{
+    path::Path,
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Arc,
+    },
+    time::Duration,
+};
+
+use async_trait::async_trait;
+use cua_driver_core::{
+    authorization::PermissionMode,
+    protocol::ToolResult,
+    session_authorization::{
+        EffectiveAuthorizationContext, SessionAuthorizationRegistry, SessionModeCeiling,
+    },
+    session_manifest::load_manifest,
+    tool::{Tool, ToolDef, ToolRegistry},
+};
+use serde_json::{json, Value};
+
+struct Probe {
+    def: ToolDef,
+    calls: Arc<AtomicUsize>,
+    display: bool,
+}
+
+#[async_trait]
+impl Tool for Probe {
+    fn def(&self) -> &ToolDef {
+        &self.def
+    }
+
+    async fn invoke(&self, _args: Value) -> ToolResult {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        if self.display {
+            ToolResult::text("synthetic display")
+                .with_structured(json!({"width": 1920, "height": 1080, "scale_factor": 1.0}))
+        } else {
+            // Exercise admission only: never start a recorder or cursor sampler.
+            ToolResult::text("recording authorization passed")
+        }
+    }
+}
+
+fn registry(include_display_probe: bool) -> (ToolRegistry, Arc<AtomicUsize>, Arc<AtomicUsize>) {
+    let recording_calls = Arc::new(AtomicUsize::new(0));
+    let display_calls = Arc::new(AtomicUsize::new(0));
+    let mut registry = ToolRegistry::new();
+    for (name, calls, display) in [
+        ("start_recording", recording_calls.clone(), false),
+        ("get_screen_size", display_calls.clone(), true),
+    ] {
+        if display && !include_display_probe {
+            continue;
+        }
+        registry.register(Box::new(Probe {
+            def: ToolDef {
+                name: name.to_owned(),
+                description: "synthetic authorization probe".to_owned(),
+                input_schema: json!({"type": "object"}),
+                read_only: display,
+                destructive: false,
+                idempotent: true,
+                open_world: false,
+            },
+            calls,
+            display,
+        }));
+    }
+    (registry, recording_calls, display_calls)
+}
+
+fn context(
+    mode: PermissionMode,
+    output: &Path,
+    window_granted: bool,
+    display_granted: bool,
+) -> Arc<EffectiveAuthorizationContext> {
+    let manifest_file = tempfile::NamedTempFile::new().unwrap();
+    let windows = if window_granted {
+        json!([{"pid": 42, "window_id": 7}])
+    } else {
+        json!([])
+    };
+    std::fs::write(
+        manifest_file.path(),
+        json!({
+            "version": 3,
+            "expires_after": "1h",
+            "idle_timeout": "30m",
+            "allow": {"tools": ["start_recording"]},
+            "resources": {
+                "desktop": {"windows": windows, "display": display_granted},
+                "files": {"write": [output.canonicalize().unwrap()]}
+            }
+        })
+        .to_string(),
+    )
+    .unwrap();
+    let manifest = Arc::new(load_manifest(manifest_file.path()).unwrap());
+    let ceiling = SessionModeCeiling::for_trusted_sessions(
+        [mode],
+        mode == PermissionMode::Unrestricted,
+        Duration::from_secs(60),
+        Duration::from_secs(30),
+    )
+    .unwrap();
+    SessionAuthorizationRegistry::with_ceiling(ceiling)
+        .compatibility_context(mode, Some(manifest))
+        .unwrap()
+}
+
+#[tokio::test]
+async fn nested_window_grant_works_without_display_discovery_and_ignores_outer_ids() {
+    let output = tempfile::tempdir().unwrap();
+    for mode in [
+        PermissionMode::Bounded,
+        PermissionMode::Standard,
+        PermissionMode::Unrestricted,
+    ] {
+        let (registry, recording_calls, display_calls) = registry(false);
+        let result = registry
+            .invoke_with_context(
+                "start_recording",
+                json!({
+                    "session": "window-recording",
+                    "output_dir": output.path(),
+                    "record_video": true,
+                    "video_target": {"pid": 42, "window_id": 7},
+                    "pid": 999,
+                    "window_id": 888,
+                    "target_id": "unrelated-browser"
+                }),
+                context(mode, output.path(), true, false),
+            )
+            .await;
+        assert_ne!(result.is_error, Some(true), "{mode:?}: {result:?}");
+        assert_eq!(recording_calls.load(Ordering::SeqCst), 1);
+        assert_eq!(display_calls.load(Ordering::SeqCst), 0);
+    }
+}
+
+#[tokio::test]
+async fn outer_window_grant_cannot_authorize_a_different_nested_target() {
+    let output = tempfile::tempdir().unwrap();
+    let (registry, recording_calls, display_calls) = registry(true);
+    let result = registry
+        .invoke_with_context(
+            "start_recording",
+            json!({
+                "session": "window-recording",
+                "output_dir": output.path(),
+                "record_video": true,
+                "video_target": {"pid": 999, "window_id": 888},
+                "pid": 42,
+                "window_id": 7
+            }),
+            context(PermissionMode::Bounded, output.path(), true, true),
+        )
+        .await;
+    assert_eq!(result.is_error, Some(true), "{result:?}");
+    assert_eq!(recording_calls.load(Ordering::SeqCst), 0);
+    assert_eq!(display_calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn display_recording_requires_display_grant_despite_outer_window_ids() {
+    let output = tempfile::tempdir().unwrap();
+    for display_granted in [false, true] {
+        let (registry, recording_calls, display_calls) = registry(true);
+        let result = registry
+            .invoke_with_context(
+                "start_recording",
+                json!({
+                    "session": "display-recording",
+                    "output_dir": output.path(),
+                    "record_video": true,
+                    "pid": 42,
+                    "window_id": 7
+                }),
+                context(
+                    PermissionMode::Bounded,
+                    output.path(),
+                    true,
+                    display_granted,
+                ),
+            )
+            .await;
+        assert_eq!(result.is_error != Some(true), display_granted, "{result:?}");
+        assert_eq!(
+            recording_calls.load(Ordering::SeqCst),
+            usize::from(display_granted)
+        );
+        assert_eq!(display_calls.load(Ordering::SeqCst), 1);
+    }
+}
+
+#[tokio::test]
+async fn trajectory_only_recording_requires_no_window_or_display_grant() {
+    let output = tempfile::tempdir().unwrap();
+    let (registry, recording_calls, display_calls) = registry(false);
+    for record_video in [None, Some(false)] {
+        let mut args = json!({
+            "session": "trajectory-recording",
+            "output_dir": output.path(),
+            "pid": 999,
+            "window_id": 888
+        });
+        if let Some(value) = record_video {
+            args["record_video"] = json!(value);
+        }
+        let result = registry
+            .invoke_with_context(
+                "start_recording",
+                args,
+                context(PermissionMode::Bounded, output.path(), false, false),
+            )
+            .await;
+        assert_ne!(result.is_error, Some(true), "{result:?}");
+    }
+    assert_eq!(recording_calls.load(Ordering::SeqCst), 2);
+    assert_eq!(display_calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn invalid_recording_targets_fail_before_display_discovery_or_dispatch() {
+    let output = tempfile::tempdir().unwrap();
+    let (registry, recording_calls, display_calls) = registry(true);
+    let mut requests = vec![
+        Value::Null,
+        json!([]),
+        json!({}),
+        json!({"pid": 42}),
+        json!({"pid": 0, "window_id": 7}),
+        json!({"pid": 2147483648_u64, "window_id": 7}),
+        json!({"pid": 42, "window_id": -1}),
+        json!({"pid": 42, "window_id": 4294967296_u64}),
+        json!({"pid": "42", "window_id": 7}),
+        json!({"pid": 42, "window_id": 7.5}),
+        json!({"pid": 42, "window_id": 7, "unexpected": true}),
+    ]
+    .into_iter()
+    .map(|target| json!({"record_video": true, "video_target": target}))
+    .collect::<Vec<_>>();
+    requests.push(json!({"video_target": {"pid": 42, "window_id": 7}}));
+    for flag in [json!(false), json!(null), json!("true"), json!(1)] {
+        requests.push(json!({
+            "record_video": flag,
+            "video_target": {"pid": 42, "window_id": 7}
+        }));
+    }
+    for mut request in requests {
+        request["output_dir"] = json!(output.path());
+        request["session"] = json!("invalid-recording");
+        request["pid"] = json!(42);
+        request["window_id"] = json!(7);
+        let result = registry
+            .invoke_with_context(
+                "start_recording",
+                request.clone(),
+                context(PermissionMode::Bounded, output.path(), true, true),
+            )
+            .await;
+        assert_eq!(result.is_error, Some(true), "{request}: {result:?}");
+    }
+    assert_eq!(recording_calls.load(Ordering::SeqCst), 0);
+    assert_eq!(display_calls.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn window_observation_grant_does_not_bypass_exact_output_directory_grant() {
+    let granted_output = tempfile::tempdir().unwrap();
+    let different_output = tempfile::tempdir().unwrap();
+    let (registry, recording_calls, display_calls) = registry(false);
+    let result = registry
+        .invoke_with_context(
+            "start_recording",
+            json!({
+                "session": "window-recording",
+                "output_dir": different_output.path(),
+                "record_video": true,
+                "video_target": {"pid": 42, "window_id": 7}
+            }),
+            context(PermissionMode::Bounded, granted_output.path(), true, false),
+        )
+        .await;
+    assert_eq!(result.is_error, Some(true), "{result:?}");
+    assert_eq!(recording_calls.load(Ordering::SeqCst), 0);
+    assert_eq!(display_calls.load(Ordering::SeqCst), 0);
+}
