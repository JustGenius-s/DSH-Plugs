+//! Model-facing action bindings for clients that render MCP text/image blocks
+//! but do not forward structuredContent to the model.
+
+use serde_json::{Map, Value};
+
+/// Keep the snapshot binding and coordinate frame beside the rendered tree.
+/// Never fabricate a token for observation-only or unresolved AX surfaces.
+pub fn window_action_context(state: &Value) -> Option<String> {
+    let fields = [
+        "pid",
+        "window_id",
+        "snapshot_id",
+        "screenshot_width",
+        "screenshot_height",
+        "window_bounds",
+        "screenshot_frame_valid",
+        "degraded_reason",
+    ];
+    let mut context = Map::new();
+    for field in fields {
+        if let Some(value) = state.get(field) {
+            context.insert(field.to_owned(), value.clone());
+        }
+    }
+    if !context.contains_key("snapshot_id")
+        && !context.contains_key("screenshot_width")
+        && !context.contains_key("degraded_reason")
+    {
+        return None;
+    }
+    let mut text = format!("Window observation context:\n{}", Value::Object(context));
+    if state.get("snapshot_id").and_then(Value::as_str).is_some() {
+        text.push_str(
+            "\nFor AX actions, pass this snapshot_id together with the element_index \
+             shown in the tree. A bare element_index is not accepted. Re-snapshot \
+             after an action changes the window.",
+        );
+    }
+    if state.get("screenshot_width").is_some() {
+        text.push_str(
+            "\nPixel x/y are coordinates in the screenshot returned by this call. \
+             Do not manually convert them to desktop points or reuse a PiP \
+             thumbnail's coordinates.",
+        );
+    }
+    Some(text)
+}
