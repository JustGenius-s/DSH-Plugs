+/// Match the window ID first, then verify its owner. Never substitute a sibling
+/// window from the same application, or an unrelated window that reused the ID.
+fn select_owned_window<W>(
+    windows: impl IntoIterator<Item = W>,
+    pid: i32,
+    window_id: u32,
+    id_of: impl Fn(&W) -> u32,
+    owner_of: impl Fn(&W) -> Option<i32>,
+) -> anyhow::Result<W> {
+    let window = windows
+        .into_iter()
+        .find(|window| id_of(window) == window_id)
+        .ok_or_else(|| {
+            anyhow::anyhow!(
+                "ScreenCaptureKit: window id {window_id} not found in shareable content \
+                 (closed, not capturable, or no longer listed)"
+            )
+        })?;
+    let owner_pid = owner_of(&window).ok_or_else(|| {
+        anyhow::anyhow!("ScreenCaptureKit: window id {window_id} has no owning application")
+    })?;
+    anyhow::ensure!(
+        owner_pid == pid,
+        "ScreenCaptureKit: window id {window_id} belongs to pid {owner_pid}, \
+         not requested pid {pid}"
+    );
+    Ok(window)
+}
+
+/// Bound the output allocation like the native screenshot path.
+const MAX_WINDOW_PIXEL_DIM: u32 = 16384;
+
+fn even_pixel_dimension(value: f64, label: &str) -> anyhow::Result<u32> {
+    anyhow::ensure!(
+        value.is_finite() && value > 0.0,
+        "invalid window video {label}: {value}"
+    );
+    // H.264 output needs even dimensions. Round up so fractional or odd
+    // extents are never truncated and the configured canvas contains the window.
+    let even = (value / 2.0).ceil() * 2.0;
+    anyhow::ensure!(
+        (2.0..=f64::from(MAX_WINDOW_PIXEL_DIM)).contains(&even),
+        "window video {label} {even} out of allowed range 2..={MAX_WINDOW_PIXEL_DIM}"
+    );
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+    Ok(even as u32)
+}
+
+fn window_pixel_dimensions(
+    content_size: (f64, f64),
+    frame_size: (f64, f64),
+    point_pixel_scale: f64,
+) -> anyhow::Result<(u32, u32)> {
+    anyhow::ensure!(
+        point_pixel_scale.is_finite() && point_pixel_scale > 0.0,
+        "invalid window video point-to-pixel scale: {point_pixel_scale}"
+    );
+    let (width, height) = if content_size.0.is_finite()
+        && content_size.1.is_finite()
+        && content_size.0 > 0.0
+        && content_size.1 > 0.0
+    {
+        content_size
+    } else {
+        // Same fallback as capture.rs: SCWindow.frame is in logical points.
+        frame_size
+    };
+    Ok((
+        even_pixel_dimension(width * point_pixel_scale, "width")?,
+        even_pixel_dimension(height * point_pixel_scale, "height")?,
+    ))
+}
+
+fn resolve_capture_target(target: &VideoTarget) -> anyhow::Result<(SCContentFilter, u32, u32)> {
+    let content = SCShareableContent::get()
+        .map_err(|e| anyhow::anyhow!("SCShareableContent::get failed: {e}"))?;
+    match target {
+        VideoTarget::Display => {
+            let display = content
+                .displays()
+                .into_iter()
+                .next()
+                .ok_or_else(|| anyhow::anyhow!("no displays available for ScreenCaptureKit"))?;
+            let filter = SCContentFilter::create()
+                .with_display(&display)
+                .with_excluding_windows(&[])
+                .build();
+            // SCDisplay already reports physical pixels. Preserve the existing
+            // display capture resolution without applying the window scale.
+            Ok((filter, display.width(), display.height()))
+        }
+        VideoTarget::Window { pid, window_id } => {
+            let window = select_owned_window(
+                content.windows(),
+                *pid,
+                *window_id,
+                |window| window.window_id(),
+                |window| {
+                    window
+                        .owning_application()
+                        .map(|application| application.process_id())
+                },
+            )?;
+            // The binding calls SCContentFilter(desktopIndependentWindow:).
+            // No display is selected or used as a fallback on this branch.
+            let filter = SCContentFilter::create().with_window(&window).build();
+            let content_rect = filter.content_rect();
+            let frame = window.frame();
+            let (width, height) = window_pixel_dimensions(
+                (content_rect.size.width, content_rect.size.height),
+                (frame.size.width, frame.size.height),
+                f64::from(filter.point_pixel_scale()),
+            )?;
+            Ok((filter, width, height))
+        }
     }
 }
 
