{
  "name": "@just-genius/dsh-plugin-runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared capability definitions and transport adapters for JustGenius DSH plugins.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./host": {
      "types": "./lib/host.d.ts",
      "import": "./lib/host.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "import": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
