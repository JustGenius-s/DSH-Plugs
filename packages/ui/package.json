{
  "name": "@just-genius/dsh-plugin-ui",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH-native UI kit: --dsw-* theme tokens plus React primitives (Button, Input, Menu, Modal, settings chrome). Usable by DSH plugins and standalone apps.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./official-primitives": {
      "types": "./lib/official-primitives.d.ts",
      "import": "./lib/official-primitives.js"
    },
    "./theme.css": "./src/theme/all.css",
    "./css-modules": {
      "types": "./lib/css-modules.d.ts",
      "import": "./lib/css-modules.js"
    },
    "./client-bundle-deps": {
      "types": "./client-bundle-deps.ts",
      "import": "./client-bundle-deps.mjs",
      "default": "./client-bundle-deps.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/theme"
  ],
  "scripts": {
    "sync-theme": "node scripts/sync-theme.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.8",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.4",
    "lightningcss": "^1.29.2",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/markdown-it": "^14.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
