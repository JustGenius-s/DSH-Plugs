{
  "name": "@just-genius/dsh-plugin-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared DSH-native UI primitives for the plugins in this monorepo. Bundled into each plugin at build time (never a runtime dependency).",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./css-modules": {
      "types": "./lib/css-modules.d.ts",
      "import": "./lib/css-modules.js"
    }
  },
  "files": ["lib"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "lightningcss": "^1.29.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3"
  }
}
