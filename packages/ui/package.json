{
  "name": "@just-genius/dsh-plugin-ui",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH-native UI kit: --dsw-* theme tokens plus React primitives (Button, Input, Menu, Modal, settings chrome). Usable by DSH plugins and standalone apps.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./theme.css": "./src/theme/all.css",
    "./css-modules": {
      "types": "./lib/css-modules.d.ts",
      "import": "./lib/css-modules.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/theme"
  ],
  "scripts": {
    "sync-theme": "node scripts/sync-theme.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lightningcss": "^1.29.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
